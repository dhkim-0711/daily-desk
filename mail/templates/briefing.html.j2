<p style="margin:0;">{% if date >= '2026-10-06' %}최근 24시간 신규 보도를 중심으로, 핵심 내용과 시사점을 정리한 일일 브리핑입니다.{% else %}최근 24시간 Daily Desk에 수집된 기사 중 주요 이슈를 선정해 핵심 내용과 시사점을 정리한 일일 브리핑입니다.{% endif %}</p>
</td></tr>
<tr><td class="section-pad" style="padding:25px 10px 12px;"><h2 class="section-title" style="margin:0 0 14px;font-size:19px;line-height:28px;font-weight:700;color:#15364a;letter-spacing:-0.3px;">1. 오늘의 핵심 요약</h2><table bgcolor="#f4f8fa" border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;table-layout:fixed;background-color:#f4f8fa;border-left:3px solid #245d78;" width="100%"><tr><td class="summary-pad" style="padding:0 12px;"><table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;table-layout:fixed;" width="100%">{% for group in summary_groups %}<tr><td class="summary-item" style="padding:14px 0;{% if not loop.first %}border-top:1px solid #dce7ed;{% endif %}">{% for number in group.article_numbers %}<p class="summary-title" style="margin:0 0 6px;font-size:16px;line-height:24px;font-weight:700;color:#15364a;word-break:normal;word-wrap:break-word;"><span style="font-family:Arial,sans-serif;font-size:12px;color:#597384;">{{ '%02d'|format(number) }}</span>  <span class="summary-title-text">{{ articles[number - 1].title }}</span></p>{% endfor %}<ul class="summary-bullets" style="margin:9px 0 0;padding:0 0 0 17px;list-style-type:disc;color:#365365;">{% for bullet in group.bullets %}<li class="summary-copy" style="margin:0 0 5px;padding:0;font-size:14px;line-height:23px;color:#365365;word-break:normal;word-wrap:break-word;overflow-wrap:break-word;">{{ bullet }}{% if loop.last %}{% for number in group.article_numbers %} {{ citations(articles[number - 1]) }}{% endfor %}{% endif %}</li>{% endfor %}</ul></td></tr>{% endfor %}</table></td></tr></table></td></tr>
<tr><td class="section-pad" style="padding:14px 10px 0;"><h2 class="section-title" style="margin:0 0 14px;font-size:19px;line-height:28px;font-weight:700;color:#15364a;letter-spacing:-0.3px;">2. 주요 기사 {{ articles|length }}건</h2>{% for article in articles %}<table border="0" cellpadding="0" cellspacing="0" class="article-card" role="presentation" style="width:100%;border:1px solid #d8e4eb;border-collapse:collapse;table-layout:fixed;margin:0 0 12px;" width="100%">
<tr><td bgcolor="#eef4f7" class="card-title-pad" style="padding:14px 12px;background-color:#eef4f7;border-bottom:1px solid #d8e4eb;"><h3 class="article-title" style="margin:0;font-size:16px;line-height:24px;font-weight:700;color:#15364a;word-break:normal;word-wrap:break-word;overflow-wrap:break-word;"><span style="display:inline-block;padding:0 6px;background-color:#15364a;color:#ffffff;font-family:Arial,sans-serif;font-size:11px;line-height:22px;font-weight:700;vertical-align:1px;">{{ '%02d'|format(article.number) }}</span>  <span class="article-title-text">{{ article.title }}</span></h3></td></tr>
<tr><td class="card-pad" style="padding:16px 12px;"><p class="block-label" style="margin:0 0 7px;font-size:12px;line-height:20px;font-weight:700;color:#315e77;">주요 내용</p>{% for paragraph in article.main_points %}<p class="body-copy" style="margin:0 0 {% if loop.last %}0{% else %}8px{% endif %};font-size:14px;line-height:23px;color:#2e4655;word-break:normal;word-wrap:break-word;overflow-wrap:break-word;">{{ paragraph }}{% if loop.last %} {{ citations(article) }}{% endif %}</p>{% endfor %}{% for reference in article.references %}<p style="margin:8px 0 0;padding:10px 12px;background-color:#f7fafb;border-left:3px solid #9ab3c1;font-size:12px;line-height:20px;color:#5b7381;word-break:normal;word-wrap:break-word;">참고 : <a href="{{ reference.url }}" rel="noopener noreferrer" style="color:#245d78;text-decoration:underline;" target="_blank">{{ reference.title }}({{ reference.publisher }}, {{ reference.date_display }})</a></p>{% endfor %}</td></tr>
<tr><td bgcolor="#f5f8fa" class="card-pad implications-pad" style="padding:14px 12px;background-color:#f5f8fa;border-top:1px solid #e5edf2;"><p class="block-label" style="margin:0 0 7px;font-size:12px;line-height:20px;font-weight:700;color:#315e77;">시사점</p>{% for paragraph in article.implications %}<p class="body-copy" style="margin:0 0 {% if loop.last %}0{% else %}8px{% endif %};font-size:14px;line-height:23px;color:#2e4655;word-break:normal;word-wrap:break-word;overflow-wrap:break-word;">{{ paragraph }}{% if loop.last %} {{ citations(article) }}{% endif %}</p>{% endfor %}</td></tr>
<tr><td class="card-meta-pad" style="padding:11px 12px;border-top:1px solid #e5edf2;"><p class="meta-copy" style="margin:0;font-size:12px;line-height:20px;color:#597384;word-break:normal;word-wrap:break-word;"><span class="meta-label" style="font-weight:700;color:#315e77;">발행일 및 출처</span> {% for source in article.sources %}{{ source.publisher }} · {{ source.date_display }} {{ citation(source) }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p></td></tr></table>{% endfor %}</td></tr>
<tr><td class="section-pad sources-section" style="padding:10px 10px 22px;"><h2 class="section-title" style="margin:0 0 14px;font-size:19px;line-height:28px;font-weight:700;color:#15364a;letter-spacing:-0.3px;">3. 출처 기사</h2><table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;table-layout:fixed;" width="100%">{% for article in articles %}{% for source in article.sources %}<tr><td style="padding:14px 0;border-top:1px solid #dce7ed;word-break:normal;word-wrap:break-word;overflow-wrap:break-word;"><p class="source-title" style="margin:0 0 6px;font-size:13px;line-height:22px;font-weight:600;"><a href="{{ source.url }}" rel="noopener noreferrer" style="color:#214e67;text-decoration:underline;" target="_blank">{{ source.mark }}  {{ source.title }}</a></p><p class="meta-copy" style="margin:0;font-size:12px;line-height:20px;color:#597384;">{{ source.publisher }} · {{ source.date_display }}</p><p class="meta-copy" style="margin:2px 0 0;font-size:12px;line-height:20px;color:#597384;">Daily Desk <span style="color:#365e75;font-weight:600;">{{ article.category }}</span></p></td></tr>{% endfor %}{% endfor %}</table></td></tr>
